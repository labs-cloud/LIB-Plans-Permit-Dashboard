# ClickUp personal API token (Settings → Apps → API). Raw token, no Bearer prefix.
CLICKUP_API_TOKEN=

# LIB workspace + Active Projects space.
CLICKUP_WORKSPACE_ID=9017603275
CLICKUP_ACTIVE_PROJECTS_SPACE_ID=90173230172

# Public base URL for ClickUp deep-links (used in URL builders).
NEXT_PUBLIC_CLICKUP_BASE_URL=https://app.clickup.com

# Resend API key — powers the in-app support bubble (Report Issue / Request Feature).
# Tickets are sent FROM labs@optentia.com TO labs@optentia.com (requires the
# optentia.com domain to be verified in Resend).
RESEND_API_KEY=
# Optional: override the sender (e.g. while the domain isn't verified yet, use
# Resend's onboarding sender: "Plans Dashboard <onboarding@resend.dev>").
# SUPPORT_FROM_EMAIL=Plans Dashboard <labs@optentia.com>
