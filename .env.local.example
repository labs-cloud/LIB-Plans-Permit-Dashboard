# ─── Access control (REQUIRED) ────────────────────────────────────────────────
# The dashboard exposes every project's budget and every subcontractor bid, and
# it has no login of its own, so access is carried by a token in the URL.
#
# Without DASHBOARD_ACCESS_TOKEN set, the app fails CLOSED and serves 503 to
# everyone — including local dev. Set it before running.
#
# Team token — full access. Put it in the ClickUp widget URL:
#   https://<site>/budget?k=<DASHBOARD_ACCESS_TOKEN>
# Generate with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
DASHBOARD_ACCESS_TOKEN=

# Secret used to derive per-project share links for owners and other outside
# parties. A share link grants read access to ONE project's budget and nothing
# else. Mint one with:
#   GET /api/share-link?projectId=<name>&k=<DASHBOARD_ACCESS_TOKEN>
# Rotating this value revokes every outstanding share link at once.
DASHBOARD_SHARE_SECRET=

# ClickUp personal API token (Settings → Apps → API). Raw token, no Bearer prefix.
CLICKUP_API_TOKEN=

# LIB workspace + Active Projects space.
CLICKUP_WORKSPACE_ID=9017603275
CLICKUP_ACTIVE_PROJECTS_SPACE_ID=90173230172

# Public base URL for ClickUp deep-links (used in URL builders).
NEXT_PUBLIC_CLICKUP_BASE_URL=https://app.clickup.com

# Resend API key — powers the in-app support bubble (Report Issue / Request Feature).
# Tickets are sent FROM labs@optentia.com TO labs@optentia.com (requires the
# optentia.com domain to be verified in Resend).
RESEND_API_KEY=
# Optional: override the sender (e.g. while the domain isn't verified yet, use
# Resend's onboarding sender: "Plans Dashboard <onboarding@resend.dev>").
# SUPPORT_FROM_EMAIL=Plans Dashboard <labs@optentia.com>
